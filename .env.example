# Copy this file to .env for local Netlify CLI development.
# Never commit .env to version control — it is already in .gitignore.
#
# Create a Google AI Studio API key:
#   https://aistudio.google.com/app/apikey
#
# The project and key must be allowed to use gemini-3.6-flash with
# Google Search grounding. Keep the real value only in local .env or
# Netlify Environment variables; never commit it.
GEMINI_API_KEY=
