# Copy this file to .env for local Netlify CLI development.
# Never commit .env to version control — it is already in .gitignore.
#
# Create a Google AI Studio API key for real production search and chat:
#   https://aistudio.google.com/app/apikey
#
# The project/key must be allowed to use gemini-3.6-flash and Google Search
# grounding. Keep the real value only in local .env or Netlify environment
# variables; never commit it. Without this value, local development uses a
# clearly labeled mock provider and production returns a configuration error.
GEMINI_API_KEY=
