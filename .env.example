# Copy this file to .env for local Netlify CLI development.
# Never commit .env to version control — it is already in .gitignore.
#
# Obtain a free API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
#
# The key must have access to:
#   - gemini-3.6-flash model
#   - Google Search grounding (enabled by default on AI Studio free tier)
GEMINI_API_KEY=
